rules_version = '2';

// ============================================================================
// Firestore 보안 규칙 — 물류팀 업무관리 (work-tool-e2943)   [관리자 전용 강화안]
//
// ⚠️ 아직 배포 전입니다. 현재 운영 규칙은 firestore.rules 입니다.
//    배포: Firebase Console → Firestore Database → 규칙(Rules) 탭에 붙여넣고 게시
//    되돌리기: 콘솔에서 이전 버전으로 다시 게시하면 됩니다 (규칙은 버전이 남습니다)
//
// 무엇이 달라지는가
//   · 읽기 : 그대로 — 로그인한 사람은 전부 읽는다
//   · 쓰기 : config/mainConfig 만 관리자 전용으로 분리
//            manuals 는 작성자 본인 또는 관리자만 수정·삭제
//            그 외(daily_data · history · notifications 등)는 그대로 전원 쓰기
//
// 왜 config/mainConfig 인가
//   이 문서에 memberRoles(누가 관리자인지)가 들어 있습니다.
//   여기를 막지 않으면 로그인한 누구나 스스로를 admin 으로 바꿀 수 있고,
//   그러면 다른 규칙을 아무리 조여도 의미가 없습니다. 여기가 급소입니다.
//
// 일부러 건드리지 않은 것 (건드리면 업무가 멈춥니다)
//   · daily_data / history / notifications / weekend_requests / persistent_data
//     → 직원이 매일 쓰는 경로입니다.
//   · config/sheetDashboard
//     → sheets-dashboard.js 가 일반 사용자 권한으로 씁니다.
//       config 컬렉션을 통째로 관리자 전용으로 만들면 이 저장이 막힙니다.
//
// 자동화 스크립트는 영향 없습니다
//   매출요약·비품자동화 등은 서비스 계정(Admin SDK)을 쓰고,
//   서비스 계정은 보안 규칙을 우회합니다. 규칙을 조여도 깨지지 않습니다.
//
// 비용
//   isAdmin() 은 mainConfig 문서를 1회 읽습니다.
//   config/mainConfig 와 manuals 쓰기에서만 호출되므로 호출량은 미미합니다.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 토큰에 email 이 없을 수도 있으므로 get(키, 기본값) 으로 안전하게 꺼낸다.
    // memberRoles 의 키는 앱에서 소문자로 저장한다(admin-ui.js, manual.js 등)
    // → 여기서도 .lower() 로 맞춰야 관리자 판정이 어긋나지 않는다.
    function emailLower() {
      return request.auth.token.get('email', '').lower();
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/artifacts/team-work-logger-v2/config/mainConfig)
             .data.get('memberRoles', {}).get(emailLower(), 'user') == 'admin';
    }

    // ── 읽기: 로그인한 사람은 앱 데이터 전체를 읽는다 ─────────────────────
    // 규칙은 OR 로 합쳐지므로, 여기에 write 를 같이 두면 아래의 제한이
    // 전부 무력화된다. 그래서 read 만 둔다.
    match /artifacts/team-work-logger-v2/{document=**} {
      allow read: if signedIn();
    }

    // ── 쓰기 ──────────────────────────────────────────────────────────────

    // 급소. 관리자만.
    match /artifacts/team-work-logger-v2/config/mainConfig {
      allow write: if isAdmin();
    }

    // 그 외 config 문서(sheetDashboard 등)는 지금처럼 전원.
    match /artifacts/team-work-logger-v2/config/{docId} {
      allow write: if signedIn() && docId != 'mainConfig';
    }

    // 매뉴얼: 새로 쓰는 건 누구나, 고치고 지우는 건 작성자 본인이나 관리자.
    // author 가 없는 옛 문서는 관리자만 손댈 수 있다.
    //   · author 는 원본 이메일 그대로 저장된다(manual.js: auth.currentUser.email)
    //     → 대소문자가 어긋나도 본인이 막히지 않도록 양쪽을 .lower() 로 맞춘다.
    //   · 로그인 안 한 요청에서 request.auth.token 을 건드리면 평가 오류가 나므로
    //     signedIn() 으로 먼저 끊는다.
    match /artifacts/team-work-logger-v2/manuals/{docId} {
      allow create: if signedIn();
      allow update, delete: if signedIn()
        && (isAdmin() || resource.data.get('author', '').lower() == emailLower());
    }

    // 나머지 업무 데이터는 그대로 전원 쓰기.
    // (daily_data · history · notifications · weekend_requests · persistent_data ·
    //  plannedData · locationStock · total_inspections_accumulated 등)
    match /artifacts/team-work-logger-v2/{colId}/{rest=**} {
      allow write: if signedIn()
        && colId != 'config'
        && colId != 'manuals';
    }

    // ── 최상위 컬렉션들 (변경 없음) ───────────────────────────────────────
    match /product_history/{document=**}                 { allow read, write: if signedIn(); }
    match /Locations/{document=**}                       { allow read, write: if signedIn(); }
    match /ZikjinData/{document=**}                      { allow read, write: if signedIn(); }
    match /WeeklyData/{document=**}                      { allow read, write: if signedIn(); }
    match /IncomingData/{document=**}                    { allow read, write: if signedIn(); }
    match /DeprecatedLog/{document=**}                   { allow read, write: if signedIn(); }
    match /OrderPairsChunks/{document=**}                { allow read, write: if signedIn(); }
    match /OrderStatsChunks/{document=**}                { allow read, write: if signedIn(); }
    match /ProcessedOrders/{document=**}                 { allow read, write: if signedIn(); }

    // ── 미발계산기 · 입고 스캐너 (변경 없음) ──────────────────────────────
    match /ChinaStockGoods/{document=**}                 { allow read, write: if signedIn(); }
    match /ChinaStockGoods_ScanDB/{document=**}          { allow read, write: if signedIn(); }
    match /ChinaStockGoods_ScanDB_Versions/{document=**} { allow read, write: if signedIn(); }
    match /ChinaStockGoods_InboundHistory/{document=**}  { allow read, write: if signedIn(); }
    match /ChinaStockGoods_StockLog/{document=**}        { allow read, write: if signedIn(); }

    // 그 외 전부 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
